# Development-safe placeholders. Replace both values before deployment.
POSTGRES_DB=volty
POSTGRES_USER=volty
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
VOLTY_JWT_SECRET=replace-with-at-least-64-random-characters

# Keep this exact production origin; do not use api.sodove.ru.
VOLTY_CORS_ORIGINS=https://volty.sodove.ru
VOLTY_VOICE_PROVIDER=unconfigured
LIVEKIT_URL=wss://voice.sodove.ru
LIVEKIT_API_KEY=replace-with-a-livekit-api-key
LIVEKIT_API_SECRET=replace-with-a-livekit-api-secret
VOLTY_VOICE_TOKEN_TTL_SECONDS=86400
VOLTY_PUBLIC_IP=203.0.113.10

# Optional online routing provider. When enabled, all four GraphHopper
# routing profiles must be configured; the app chooses one from style/speed.
VOLTY_NAV_PROVIDER=disabled
VOLTY_NAVIGATION_ENABLED=false
GRAPHHOPPER_API_KEY=replace-with-a-graphhopper-api-key
VOLTY_NAV_PROFILE=personal-mobility
VOLTY_NAV_PROFILE_MOTORCYCLE=personal-mobility-motorcycle
VOLTY_NAV_PROFILE_BICYCLE=personal-mobility-bicycle
VOLTY_NAV_PROFILE_PEDESTRIAN=personal-mobility-pedestrian

# Host-loopback ports consumed by nginx; the container ports stay 8080/7880.
VOLTY_APP_HOST_PORT=18080
VOLTY_LIVEKIT_HTTP_HOST_PORT=17880
