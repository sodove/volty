# Development-safe placeholders. Replace both values before deployment.
POSTGRES_DB=volty
POSTGRES_USER=volty
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
VOLTY_JWT_SECRET=replace-with-at-least-64-random-characters

# Keep this exact production origin; do not use api.sodove.ru.
VOLTY_CORS_ORIGINS=https://volty.sodove.ru
VOLTY_VOICE_PROVIDER=unconfigured
LIVEKIT_URL=wss://voice.sodove.ru
LIVEKIT_API_KEY=replace-with-a-livekit-api-key
LIVEKIT_API_SECRET=replace-with-a-livekit-api-secret
VOLTY_VOICE_TOKEN_TTL_SECONDS=86400
VOLTY_PUBLIC_IP=203.0.113.10

# Online routing is intentionally disabled until the self-hosted Valhalla
# backend adapter is ready. Do not add third-party routing credentials here.
VOLTY_NAV_PROVIDER=disabled
VOLTY_NAVIGATION_ENABLED=false

# Ktor has read-only legacy access; the optional offline service owns publication.
# No private signing keys belong here or in the package store.
VOLTY_OFFLINE_HOST_DIR=/home/sodovaya/volty/offline
VOLTY_OFFLINE_ROOT=/opt/volty/offline
VOLTY_OFFLINE_PUBLIC_BASE_URL=https://volty.sodove.ru/offline/regions
# To enable automatic acquisition, configure these values and run deploy.sh,
# or use docker compose --profile offline up with MANAGER_URL=http://offline:8091.
# Catalog/manifests must be signed by the release pipeline for PUBLIC_BASE_URL.
VOLTY_OFFLINE_MANAGER_URL=
VOLTY_OFFLINE_UPSTREAM_CATALOG_URL=
VOLTY_OFFLINE_ARTIFACT_BASE_URL=
VOLTY_OFFLINE_PUBLIC_KEY=
VOLTY_OFFLINE_KEY_ID=
# Optional operator ingest; pipeline writes ID/VERSION under this dedicated root.
VOLTY_OFFLINE_INGEST_HOST_DIR=/home/sodovaya/volty/offline-ingest
# Production builder bundle (paths are on the VPS host).
VOLTY_OFFLINE_STAGING_HOST_DIR=/home/sodovaya/volty/offline-production/staging
VOLTY_OFFLINE_SOURCE_HOST_DIR=/home/sodovaya/volty/offline-production/sources
VOLTY_OFFLINE_CONFIG_HOST=/home/sodovaya/volty/offline-production/production.json
VOLTY_OFFLINE_SIGNING_KEY_HOST=/home/sodovaya/volty/offline-production/secrets/signing-key.pem
# Set to the measured group id of /var/run/docker.sock on the VPS.
VOLTY_DOCKER_GID=999

# Host-loopback ports consumed by nginx; the container ports stay 8080/7880.
VOLTY_APP_HOST_PORT=18080
VOLTY_LIVEKIT_HTTP_HOST_PORT=17880
