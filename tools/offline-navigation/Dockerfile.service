FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
RUN pip install --no-cache-dir 'cryptography==46.0.7' && useradd --uid 10001 --create-home volty
WORKDIR /app
COPY package-service.py package_cache.py package_validation.py build-catalog.py verify-package.py ./
RUN mkdir -p /data/offline && chown volty:volty /data/offline
USER volty
ENV VOLTY_OFFLINE_ROOT=/data/offline VOLTY_OFFLINE_PORT=8091 PYTHONUNBUFFERED=1
EXPOSE 8091
ENTRYPOINT ["python", "package-service.py"]
