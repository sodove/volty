<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Legacy Bluetooth permissions: required for BLE scan/connect on
         API 26-30 (minSdk 26). Normal permissions, granted at install. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Social location is requested only from Nearby after explicit sharing
         consent. Keeping these declarations separate from BLE monitoring means
         entering the app still does not imply location sharing. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Offline Wi-Fi radio (Wi-Fi Direct group, Android 10+). NEARBY_WIFI_DEVICES replaces
         location for Wi-Fi Direct on API 33+; below that the location permissions above apply. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <!-- HTTPS social transport, map tiles and the future WebRTC/SFU adapter. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Requested only after the user confirms joining a voice room. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The audible alarm's haptic half (F §4). Normal permission, granted at
         install; without it Vibrator.vibrate silently does nothing. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:name=".VoltyApplication"
        android:label="Volty"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Account-owned push startup enables auto-init only after authentication. -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <service android:name=".data.nearby.VoltyFirebaseMessagingService" android:exported="false">
            <intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT" /></intent-filter>
        </service>
        <meta-data
            android:name="ru.sodovaya.volty.offline.catalog_url"
            android:value="${voltyOfflineCatalogUrl}" />
        <meta-data
            android:name="ru.sodovaya.volty.offline.manifest_key_id"
            android:value="${voltyOfflineManifestKeyId}" />
        <meta-data
            android:name="ru.sodovaya.volty.offline.manifest_public_key"
            android:value="${voltyOfflineManifestPublicKey}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
<!--            android:screenOrientation="portrait"-->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".service.MonitoringService"
            android:foregroundServiceType="connectedDevice|location"
            android:exported="false" />
        <activity android:name=".diagnostics.voice.VoiceDiagnosticActivity"
            android:exported="false" android:launchMode="singleTop" />
        <service android:name=".diagnostics.voice.VoiceDiagnosticService"
            android:foregroundServiceType="microphone" android:exported="false" />
        <service android:name=".data.voice.NearbyVoiceService"
            android:foregroundServiceType="microphone" android:exported="false" />
        <receiver android:name=".data.voice.IncomingCallDeclineReceiver" android:exported="false" />
        <activity android:name=".data.voice.IncomingCallActivity"
            android:exported="false" android:launchMode="singleTop"
            android:taskAffinity="ru.sodovaya.volty.incoming"
            android:excludeFromRecents="true" />
        <service android:name=".data.voice.NearbyChannelLocationService"
            android:foregroundServiceType="location" android:exported="false" />

        <!-- Shares the exported logcat file with the chosen app (see LogExporter). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
