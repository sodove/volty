CREATE TABLE HistoryMarkerV2 (
  rideId TEXT NOT NULL,
  sequence INTEGER NOT NULL,
  epochMillis INTEGER NOT NULL,
  elapsedMillis INTEGER NOT NULL,
  clockGeneration INTEGER NOT NULL,
  kind TEXT NOT NULL,
  sourceId TEXT,
  PRIMARY KEY(rideId, sequence),
  FOREIGN KEY(rideId) REFERENCES HistoryRideV2(id) ON DELETE CASCADE
);
CREATE INDEX HistoryMarkerV2_ride_elapsed ON HistoryMarkerV2(rideId, elapsedMillis, sequence);

insertMarker:
INSERT INTO HistoryMarkerV2(rideId, sequence, epochMillis, elapsedMillis, clockGeneration, kind, sourceId)
VALUES (:rideId, :sequence, :epochMillis, :elapsedMillis, :clockGeneration, :kind, :sourceId);

markersForRide:
SELECT * FROM HistoryMarkerV2 WHERE rideId = :rideId AND elapsedMillis >= :fromElapsed AND elapsedMillis <= :toElapsed ORDER BY elapsedMillis, sequence LIMIT :pageSize;

deleteMarkers:
DELETE FROM HistoryMarkerV2 WHERE rideId = :rideId;


markersForReceipt:
SELECT * FROM HistoryMarkerV2 WHERE rideId = :rideId AND sequence >= :firstSequence AND sequence < :nextSequence ORDER BY sequence;

hasEvidenceGap:
SELECT EXISTS(SELECT 1 FROM HistoryMarkerV2 WHERE rideId = :rideId
AND elapsedMillis >= :fromElapsed AND elapsedMillis <= :toElapsed
AND (sourceId IS NULL OR sourceId = :sourceId)
AND kind IN ('BLE_GAP', 'CLOCK_CHANGE', 'OVERFLOW', 'INTERRUPTED')) AS hasGap;
