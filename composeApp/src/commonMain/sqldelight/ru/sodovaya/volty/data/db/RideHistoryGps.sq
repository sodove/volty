CREATE TABLE HistoryGpsV2 (
  rideId TEXT NOT NULL,
  sequence INTEGER NOT NULL,
  epochMillis INTEGER NOT NULL,
  elapsedMillis INTEGER NOT NULL,
  clockGeneration INTEGER NOT NULL,
  latitude REAL NOT NULL,
  longitude REAL NOT NULL,
  accuracyMeters REAL NOT NULL,
  headingDegrees REAL,
  PRIMARY KEY(rideId, sequence),
  FOREIGN KEY(rideId) REFERENCES HistoryRideV2(id) ON DELETE CASCADE
);
CREATE INDEX HistoryGpsV2_ride_elapsed ON HistoryGpsV2(rideId, elapsedMillis, sequence);

insertGps:
INSERT INTO HistoryGpsV2(rideId, sequence, epochMillis, elapsedMillis, clockGeneration, latitude, longitude,
accuracyMeters, headingDegrees) VALUES (:rideId, :sequence, :epochMillis, :elapsedMillis, :clockGeneration,
:latitude, :longitude, :accuracyMeters, :headingDegrees);

pageGps:
SELECT * FROM HistoryGpsV2 WHERE rideId = :rideId AND elapsedMillis >= :fromElapsed AND elapsedMillis <= :toElapsed
AND (:afterElapsed IS NULL OR elapsedMillis > :afterElapsed OR (elapsedMillis = :afterElapsed AND sequence > :afterSequence))
ORDER BY elapsedMillis, sequence LIMIT :pageSize;

deleteGps:
DELETE FROM HistoryGpsV2 WHERE rideId = :rideId;
