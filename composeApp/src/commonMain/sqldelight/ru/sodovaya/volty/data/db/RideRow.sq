-- One completed telemetry session. Points live in RidePointRow so the ride
-- list remains cheap to load and deleting a ride can be explicit on old SQLite.
CREATE TABLE RideRow (
    id        TEXT NOT NULL PRIMARY KEY,
    vehicleId TEXT NOT NULL,
    startedAt TEXT NOT NULL,
    endedAt   TEXT
);

CREATE INDEX RideRow_vehicle_started ON RideRow(vehicleId, startedAt DESC);

selectAll:
SELECT * FROM RideRow ORDER BY startedAt DESC;

selectByVehicle:
SELECT * FROM RideRow WHERE vehicleId = :vehicleId ORDER BY startedAt DESC;

selectById:
SELECT * FROM RideRow WHERE id = :id;

insert:
INSERT OR REPLACE INTO RideRow(id, vehicleId, startedAt, endedAt)
VALUES (:id, :vehicleId, :startedAt, :endedAt);

finish:
UPDATE RideRow SET endedAt = :endedAt WHERE id = :id;

delete:
DELETE FROM RideRow WHERE id = :id;

deleteOldest:
DELETE FROM RideRow
WHERE id IN (
    SELECT id FROM RideRow ORDER BY startedAt ASC LIMIT :count
);

-- Strip the fraction before asking SQLite for whole seconds, then truncate the
-- original fraction explicitly. SQLite date-function rounding must not move a
-- .999999999 fix/ride into the next millisecond/second. Keep the timezone suffix.
pageLegacyHistory:
WITH fractions AS (
    SELECT *, CASE WHEN substr(startedAt, 20, 1) = '.' THEN
        max(instr(substr(startedAt, 21), 'Z'), instr(substr(startedAt, 21), '+'), instr(substr(startedAt, 21), '-'))
        ELSE 0 END AS zoneStart
    FROM RideRow
), timed AS (
    SELECT *, CAST(strftime('%s', CASE WHEN zoneStart > 0
        THEN substr(startedAt, 1, 19) || substr(startedAt, 20 + zoneStart) ELSE startedAt END) AS INTEGER) * 1000
        + CASE WHEN zoneStart > 0 THEN CAST(substr(substr(startedAt, 21, zoneStart - 1) || '000', 1, 3) AS INTEGER)
          ELSE 0 END AS capturedMillis
    FROM fractions
)
SELECT id, vehicleId, startedAt, endedAt FROM timed
WHERE :beforeEpoch IS NULL OR capturedMillis < :beforeEpoch
OR (capturedMillis = :beforeEpoch AND id < :beforeId)
ORDER BY capturedMillis DESC, id DESC LIMIT :pageSize;
