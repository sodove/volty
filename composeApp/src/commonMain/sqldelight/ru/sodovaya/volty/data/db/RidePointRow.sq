-- Downsampled, evidence-aware telemetry. A missing metric has no row; the
-- known bit is retained for import/export and deliberate gap tests.
CREATE TABLE RidePointRow (
    rideId    TEXT NOT NULL,
    metricKey TEXT NOT NULL,
    timestamp TEXT NOT NULL,
    cellIndex INTEGER NOT NULL DEFAULT -1,
    value     REAL NOT NULL,
    isKnown   INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (rideId, metricKey, timestamp, cellIndex),
    FOREIGN KEY (rideId) REFERENCES RideRow(id) ON DELETE CASCADE
);

CREATE INDEX RidePointRow_ride_time ON RidePointRow(rideId, timestamp, metricKey);

selectByRide:
SELECT * FROM RidePointRow WHERE rideId = :rideId ORDER BY timestamp, metricKey, cellIndex;

insert:
INSERT OR REPLACE INTO RidePointRow(rideId, metricKey, timestamp, cellIndex, value, isKnown)
VALUES (:rideId, :metricKey, :timestamp, :cellIndex, :value, :isKnown);

deleteByRide:
DELETE FROM RidePointRow WHERE rideId = :rideId;

selectBoundedHistory:
SELECT * FROM RidePointRow WHERE rideId = :rideId
ORDER BY CAST(strftime('%s', timestamp) AS INTEGER),
         CAST(substr(strftime('%f', timestamp), 4, 3) AS INTEGER), timestamp, metricKey, cellIndex
LIMIT :pageSize;

selectHistoryMetricKeys:
SELECT DISTINCT metricKey FROM RidePointRow WHERE rideId = :rideId ORDER BY metricKey;

-- Filter the selected key before the bound: other metrics cannot consume its
-- page. Fractions are truncated exactly as Instant.toEpochMilliseconds does;
-- preserve Z/offset when parsing whole seconds, independent of SQLite rounding.
selectHistorySeries:
WITH fractions AS (
    SELECT *, CASE WHEN substr(timestamp, 20, 1) = '.' THEN
        max(instr(substr(timestamp, 21), 'Z'), instr(substr(timestamp, 21), '+'), instr(substr(timestamp, 21), '-'))
        ELSE 0 END AS zoneStart
    FROM RidePointRow WHERE rideId = :rideId AND metricKey = :metricKey AND cellIndex = :cellIndex
), timed AS (
    SELECT *, CAST(strftime('%s', CASE WHEN zoneStart > 0
        THEN substr(timestamp, 1, 19) || substr(timestamp, 20 + zoneStart) ELSE timestamp END) AS INTEGER) * 1000
        + CASE WHEN zoneStart > 0 THEN CAST(substr(substr(timestamp, 21, zoneStart - 1) || '000', 1, 3) AS INTEGER)
          ELSE 0 END AS capturedMillis
    FROM fractions
)
SELECT rideId, metricKey, timestamp, cellIndex, value, isKnown FROM timed
WHERE capturedMillis >= :fromEpoch AND capturedMillis <= :toEpoch
ORDER BY capturedMillis, timestamp LIMIT :pageSize;


selectRecordedHistoryMetricKeys:
SELECT DISTINCT metricKey FROM RidePointRow
WHERE rideId = :rideId AND cellIndex = -1 AND metricKey IN :metricKeys
ORDER BY metricKey LIMIT :pageSize;

-- Available wall-time evidence only; this does not finish an unclosed ride.
-- Reuse exact millisecond truncation from selectHistorySeries, not MAX(text)
-- or SQLite's rounded fractional-second parser. Return original boundary strings
-- so Kotlin also validates their Instant representation.
selectLegacyRecordedRange:
WITH fractions AS (
    SELECT timestamp, CASE WHEN substr(timestamp, 20, 1) = '.' THEN
        max(instr(substr(timestamp, 21), 'Z'), instr(substr(timestamp, 21), '+'), instr(substr(timestamp, 21), '-'))
        ELSE 0 END AS zoneStart
    FROM RidePointRow WHERE rideId = :rideId
), timed AS (
    SELECT timestamp, CAST(strftime('%s', CASE WHEN zoneStart > 0
        THEN substr(timestamp, 1, 19) || substr(timestamp, 20 + zoneStart) ELSE timestamp END) AS INTEGER) * 1000
        + CASE WHEN zoneStart > 0 THEN CAST(substr(substr(timestamp, 21, zoneStart - 1) || '000', 1, 3) AS INTEGER)
          ELSE 0 END AS capturedMillis
    FROM fractions
)
SELECT COUNT(*) AS totalRows, COUNT(capturedMillis) AS parsedRows,
    COALESCE((SELECT timestamp FROM timed ORDER BY capturedMillis, timestamp LIMIT 1), '') AS firstTimestamp,
    COALESCE((SELECT timestamp FROM timed ORDER BY capturedMillis DESC, timestamp DESC LIMIT 1), '') AS lastTimestamp
FROM timed;
