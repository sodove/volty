-- Vehicle profile table. One row per saved vehicle. Named VehicleRow to avoid
-- collision with the domain class ru.sodovaya.volty.domain.model.Vehicle.
-- Per-pack data (which BMS, at which address, how many cells) lives in PackRow.

CREATE TABLE VehicleRow (
    id                       TEXT NOT NULL PRIMARY KEY,
    name                     TEXT NOT NULL,
    iconKey                  TEXT NOT NULL,
    topology                 TEXT NOT NULL DEFAULT 'PARALLEL',  -- enum name: PARALLEL | SERIES
    chemistry                TEXT NOT NULL,   -- enum name: LI_ION_NMC | LIFEPO4 | LEAD_ACID
    averagingWindowMin       INTEGER NOT NULL DEFAULT 5,
    cellHighV                REAL,
    cellLowV                 REAL,
    cellDeltaMv              INTEGER,
    temperatureWarnC         REAL,
    temperatureHighC         REAL,
    socLowPercent            INTEGER,
    socCutoffPercent         INTEGER,
    disconnectNotify         INTEGER NOT NULL DEFAULT 1,
    chargeCompleteNotify     INTEGER NOT NULL DEFAULT 1,
    createdAt                TEXT NOT NULL,    -- ISO-8601
    lastConnectedAt          TEXT,             -- ISO-8601 or NULL
    isPinned                 INTEGER NOT NULL DEFAULT 0,
    dashboardStyle           TEXT,             -- enum name: CLEAN | CLASSIC, NULL = follow app default
    secondaryGauge           TEXT,             -- enum name: DUTY | BATTERY | POWER | CURRENT | MOTOR_TEMP | ESC_TEMP | CONSUMPTION
    yieldBmsToHeadUnit       INTEGER,          -- 1 = yes, 0 = no, NULL = follow the default (yes). See Vehicle.yieldBmsToHeadUnit.
    -- Has the rider ever configured motion alerts on this vehicle? 0 = no, so
    -- AlarmDefaults apply; 1 = yes, so AlertLevelRow is the whole truth even
    -- when it holds no rows for this vehicle (= every kind switched off).
    -- Not inferable from AlertLevelRow being empty — see 6.sqm.
    motionAlertsConfigured   INTEGER NOT NULL DEFAULT 0,
    -- The learned widths of the CURRENT and POWER dials (G §9.2), in amps and
    -- watts. NOT NULL DEFAULT 0 because zero IS the answer for a vehicle nobody
    -- has ridden — see Vehicle.gaugePeakCurrentA and 7.sqm.
    gaugePeakCurrentA        REAL NOT NULL DEFAULT 0,
    gaugePeakPowerW          REAL NOT NULL DEFAULT 0
);

CREATE INDEX VehicleRow_pinned_recent ON VehicleRow(isPinned DESC, lastConnectedAt DESC, createdAt DESC);

selectAll:
SELECT * FROM VehicleRow ORDER BY isPinned DESC, COALESCE(lastConnectedAt, createdAt) DESC;

selectById:
SELECT * FROM VehicleRow WHERE id = :id;

upsert:
INSERT OR REPLACE INTO VehicleRow(
    id, name, iconKey, topology, chemistry, averagingWindowMin,
    cellHighV, cellLowV, cellDeltaMv, temperatureWarnC, temperatureHighC, socLowPercent, socCutoffPercent,
    disconnectNotify, chargeCompleteNotify, createdAt, lastConnectedAt, isPinned, dashboardStyle, secondaryGauge,
    yieldBmsToHeadUnit, motionAlertsConfigured, gaugePeakCurrentA, gaugePeakPowerW
) VALUES (
    :id, :name, :iconKey, :topology, :chemistry, :averagingWindowMin,
    :cellHighV, :cellLowV, :cellDeltaMv, :temperatureWarnC, :temperatureHighC, :socLowPercent, :socCutoffPercent,
    :disconnectNotify, :chargeCompleteNotify, :createdAt, :lastConnectedAt, :isPinned, :dashboardStyle, :secondaryGauge,
    :yieldBmsToHeadUnit, :motionAlertsConfigured, :gaugePeakCurrentA, :gaugePeakPowerW
);

delete:
DELETE FROM VehicleRow WHERE id = :id;

touch:
UPDATE VehicleRow SET lastConnectedAt = :now WHERE id = :id;

-- Two columns, no children — the same shape as `touch` and for the same reason.
-- The ride dashboard writes the learned dial widths while the rider is riding,
-- from a Vehicle snapshot that may be minutes old; a full `upsert` would replay
-- that snapshot's packs, controllers and alert levels over rows the connection
-- itself may have moved underneath it (KableBmsRepository.maybePersistPacks
-- appends a Begode's second branch mid-ride). A targeted UPDATE cannot.
updateGaugePeaks:
UPDATE VehicleRow
SET gaugePeakCurrentA = :gaugePeakCurrentA, gaugePeakPowerW = :gaugePeakPowerW
WHERE id = :id;
