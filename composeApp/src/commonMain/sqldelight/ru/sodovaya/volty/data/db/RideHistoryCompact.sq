-- Compact history tables (plan 2026-10-29-compact-history-storage). Created by 27.sqm; 28.sqm converted every V2 ride and
-- dropped HistorySampleV2, so every ride has a HistoryRideKeyV3 row and these tables are the only sample store.
--
-- HistoryRideKeyV3   rideNo is a small integer standing for the 36-character rideId, so a series row carries 1-3 bytes
--                    instead of a UUID.
-- HistorySeriesV3    one row per (ride, source, metric, cell); seriesId replaces the four-column key in every sample.
-- HistorySampleV3    one row per known sample or per unknown RUN, WITHOUT ROWID so the primary key IS the table:
--                    (seriesId, elapsedMillis, sequence) is the read order of every reader and there is no second index.
--
-- Ids are allocated by the writer as MAX+1 (maxRideNoV3, maxSeriesIdV3) and, with no AUTOINCREMENT, a deleted highest id is
-- REUSED. That is safe only because a ride is deleted in ONE transaction (samples of its series, then the series, then the
-- key); a delete that left samples behind would hand them to the next ride. Tasks 5/6 must keep that transaction.
-- V2 samples whose HistoryRideV2 row was missing were not converted (28.sqm says why).
-- Known-row epochSkew is 0 only while wall and monotonic clocks agree; NTP slew or a clock step makes later rows 1-5 bytes.
--
-- Per-sample epoch and clock generation, decided here (Task 4):
--   epochSkew  = (sample.epochMillis - sample.elapsedMillis) - (ride.started.epochMillis - ride.started.elapsedMillis)
--   clockDelta = sample.clockGeneration - ride.started.clockGeneration
-- so epochMillis = elapsedMillis + rideOriginSkew + epochSkew, EXACTLY, for every row (the fingerprint compares epoch
-- and generation of each known sample, and historyAxisEpochMillis/clockBoundary read both). Both are 0 for nearly every
-- row, which SQLite stores in 0 bytes of payload (serial type 8/9 integers 0 and 1), and a few milliseconds of wobble
-- cost one byte. The ride origin comes from HistoryRideV2.started*. An earlier idea, one skew per run only, would have
-- lost the epoch of known samples; known rows therefore keep their own.
--
-- unknownCode: >= 1, the ordinal+1 of the unknown reason. The mapping AND its upper bound live in the Task 5 codec, not in
-- SQL: a CHECK cannot be altered, so BETWEEN 1 AND 5 would have made a 6th HistoryUnknownReason (Part P) cost a table
-- rebuild of hundreds of MB. An earlier revision capped the code at 5; that was wrong for that reason. An unmapped code reads
-- back as invalid data. The writer maps NaN readings explicitly (SQLite stores NaN as NULL, which would hit the CHECK).
-- A run row (runCount IS NOT NULL) is an unknown that stands for runCount samples evenly spaced from
-- (elapsedMillis, sequence) to (runEndElapsed, runEndSequence), runCount >= 2. Task 3: a stored run must satisfy
-- runEndElapsed - elapsedMillis <= 2000 * (runCount - 1).
-- runEndEpochSkew (set iff the row is a run) is the END member's own skew, so the end tick is exact. An earlier revision
-- (Task 5 first draft) had no such column and rebuilt the end with the FIRST member's skew; that was wrong: a chain whose
-- skew wobbled (36.5 % of real steps move 1 ms) read back an end epoch up to 14 ms off, which the `samples` reader and the
-- Task 2 fingerprint print. It also forced the writer onto a first-member split rule that differed from
-- collapseUnknownRuns. With the exact end the writer compares neighbours, exactly as collapseUnknownRuns does.
-- Every CHECK spells out IS NOT NULL: a CHECK that evaluates to NULL PASSES in SQLite, so the first draft (without it)
-- accepted a row with neither a reading nor a code, and a run with a NULL end. Both are rejected now (tested).
-- No foreign keys: application foreign_keys are OFF (SqlDelightHistoryStore), deletion is explicit.

CREATE TABLE HistoryRideKeyV3 (
  rideNo INTEGER NOT NULL PRIMARY KEY,
  rideId TEXT NOT NULL UNIQUE
);

CREATE TABLE HistorySeriesV3 (
  seriesId INTEGER NOT NULL PRIMARY KEY,
  rideNo INTEGER NOT NULL,
  sourceId TEXT NOT NULL,
  metricId TEXT NOT NULL,
  cellIndex INTEGER NOT NULL DEFAULT -1 CHECK(cellIndex >= -1),
  UNIQUE(rideNo, sourceId, metricId, cellIndex)
);

CREATE TABLE HistorySampleV3 (
  seriesId INTEGER NOT NULL,
  elapsedMillis INTEGER NOT NULL,
  sequence INTEGER NOT NULL,
  epochSkew INTEGER NOT NULL DEFAULT 0,
  clockDelta INTEGER NOT NULL DEFAULT 0,
  reading REAL,
  unknownCode INTEGER,
  runEndElapsed INTEGER,
  runEndSequence INTEGER,
  runEndEpochSkew INTEGER,
  runCount INTEGER,
  PRIMARY KEY(seriesId, elapsedMillis, sequence),
  CHECK((reading IS NULL AND unknownCode IS NOT NULL AND unknownCode >= 1) OR (reading IS NOT NULL AND unknownCode IS NULL)),
  CHECK((runCount IS NULL AND runEndElapsed IS NULL AND runEndSequence IS NULL AND runEndEpochSkew IS NULL) OR
    (unknownCode IS NOT NULL AND runCount IS NOT NULL AND runEndElapsed IS NOT NULL AND runEndSequence IS NOT NULL AND
      runEndEpochSkew IS NOT NULL AND runCount >= 2 AND runEndElapsed >= elapsedMillis AND runEndSequence > sequence))
) WITHOUT ROWID;

insertRideKeyV3:
INSERT INTO HistoryRideKeyV3(rideNo, rideId) VALUES (:rideNo, :rideId);

rideNoV3:
SELECT rideNo FROM HistoryRideKeyV3 WHERE rideId = :rideId;

maxRideNoV3:
SELECT COALESCE(MAX(rideNo), 0) FROM HistoryRideKeyV3;

maxSeriesIdV3:
SELECT COALESCE(MAX(seriesId), 0) FROM HistorySeriesV3;

insertSeriesV3:
INSERT INTO HistorySeriesV3(seriesId, rideNo, sourceId, metricId, cellIndex)
VALUES (:seriesId, :rideNo, :sourceId, :metricId, :cellIndex);

seriesForV3:
SELECT seriesId FROM HistorySeriesV3
WHERE rideNo = :rideNo AND sourceId = :sourceId AND metricId = :metricId AND cellIndex = :cellIndex;

-- Sorts through a temp b-tree after the UNIQUE-index prefix scan; tens of rows per ride, so harmless.
seriesOfRideV3:
SELECT * FROM HistorySeriesV3 WHERE rideNo = :rideNo ORDER BY seriesId;

insertSampleV3:
INSERT INTO HistorySampleV3(seriesId, elapsedMillis, sequence, epochSkew, clockDelta, reading, unknownCode,
runEndElapsed, runEndSequence, runEndEpochSkew, runCount)
VALUES (:seriesId, :elapsedMillis, :sequence, :epochSkew, :clockDelta, :reading, :unknownCode,
:runEndElapsed, :runEndSequence, :runEndEpochSkew, :runCount);

deleteSamplesOfSeriesV3:
DELETE FROM HistorySampleV3 WHERE seriesId = :seriesId;

deleteSeriesOfRideV3:
DELETE FROM HistorySeriesV3 WHERE rideNo = :rideNo;

deleteRideKeyV3:
DELETE FROM HistoryRideKeyV3 WHERE rideNo = :rideNo;


-- Task 5 (writer). The last row of a series at or before an elapsed, in reader order: one backwards seek on the primary
-- key. For an in-order sample it is the series' newest row; for a late one it is the run that might contain it.
latestAtOrBeforeV3:
SELECT * FROM HistorySampleV3 WHERE seriesId = :seriesId AND elapsedMillis <= :elapsedMillis
ORDER BY elapsedMillis DESC, sequence DESC LIMIT 1;

-- The last row that STARTS strictly before an elapsed: the only run a marker at that elapsed can cut.
latestBeforeV3:
SELECT * FROM HistorySampleV3 WHERE seriesId = :seriesId AND elapsedMillis < :elapsedMillis
ORDER BY elapsedMillis DESC, sequence DESC LIMIT 1;

-- Extends a lone unknown or a run in place, or (all NULL) shrinks a split run to its first member; the row is addressed
-- by its full primary key.
extendRunV3:
UPDATE HistorySampleV3 SET runCount = :runCount, runEndElapsed = :runEndElapsed, runEndSequence = :runEndSequence,
runEndEpochSkew = :runEndEpochSkew
WHERE seriesId = :seriesId AND elapsedMillis = :elapsedMillis AND sequence = :sequence;

deleteSamplesOfRideV3:
DELETE FROM HistorySampleV3 WHERE seriesId IN (SELECT seriesId FROM HistorySeriesV3 WHERE rideNo = :rideNo);

samplesOfSeriesV3:
SELECT * FROM HistorySampleV3 WHERE seriesId = :seriesId ORDER BY elapsedMillis, sequence;

-- The committed markers that could split a run of :sourceId between its end and the next sample. The gap kinds are
-- filtered in Kotlin by historyRunContinues (HISTORY_GAP_MARKERS), so the set is defined once.
markersAfterV3:
SELECT * FROM HistoryMarkerV2 WHERE rideId = :rideId AND elapsedMillis > :afterElapsed AND elapsedMillis <= :toElapsed
AND (sourceId IS NULL OR sourceId = :sourceId) ORDER BY elapsedMillis, sequence;

-- Task 6 (readers). Every query below walks the primary key of ONE series; none orders by sequence across series.

-- The last row at or before an (elapsed, sequence) cursor: the only run a page that starts at that cursor can resume
-- inside. The elapsed bound is a plain range on the key; the sequence test only filters rows at that elapsed.
latestAtOrBeforeKeyV3:
SELECT * FROM HistorySampleV3 WHERE seriesId = :seriesId AND elapsedMillis <= :elapsedMillis
AND (elapsedMillis < :elapsedMillis OR sequence <= :sequence)
ORDER BY elapsedMillis DESC, sequence DESC LIMIT 1;

-- Rows that START in [lowElapsed, toElapsed] and after the cursor, in reader order. :lowElapsed is max(from, cursor
-- elapsed), so a page does not rescan the rows before its cursor.
pageSamplesV3:
SELECT * FROM HistorySampleV3 WHERE seriesId = :seriesId AND elapsedMillis >= :lowElapsed AND elapsedMillis <= :toElapsed
AND (:afterElapsed IS NULL OR elapsedMillis > :afterElapsed OR (elapsedMillis = :afterElapsed AND sequence > :afterSequence))
ORDER BY elapsedMillis, sequence LIMIT :pageSize;

-- Rows that START in [from, to]. unknownCount counts run MEMBERS; lastElapsed is a run's end. The two runs a range can
-- cut (the one starting before :from, and one ending after :to) are corrected in Kotlin by expansion (HistoryCompactReader).
rangeDetailStatsV3:
SELECT MIN(reading) AS minimum, MAX(reading) AS maximum,
COALESCE(SUM(CASE WHEN unknownCode IS NULL THEN 0 ELSE COALESCE(runCount, 1) END), 0) AS unknownCount,
MAX(COALESCE(runEndElapsed, elapsedMillis)) AS lastElapsed
FROM HistorySampleV3 WHERE seriesId = :seriesId AND elapsedMillis >= :fromElapsed AND elapsedMillis <= :toElapsed;

seriesOfOtherSourcesV3:
SELECT * FROM HistorySeriesV3 WHERE rideNo = :rideNo AND sourceId != :sourceId ORDER BY seriesId;

-- Task 11 (background compaction, HistoryStorageMaintenance). No schema change: the work left is derived from the rows.

-- Closed compact rides, oldest key first. A ride still RECORDING belongs to the writer and is never compacted.
compactionRidesV3:
SELECT k.rideNo FROM HistoryRideKeyV3 k JOIN HistoryRideV2 r ON r.id = k.rideId WHERE r.status != 'RECORDING' ORDER BY k.rideNo;

-- Re-read inside the ride's transaction: the ride may have been deleted or reopened since the list was taken.
compactionRideV3:
SELECT k.rideId, r.status, r.startedEpochMillis, r.startedElapsedMillis, r.clockGeneration
FROM HistoryRideKeyV3 k JOIN HistoryRideV2 r ON r.id = k.rideId WHERE k.rideNo = :rideNo;

-- The unknown rows of one series in reader order. Walks the series' primary-key range; the filter drops known rows.
unknownRowsOfSeriesV3:
SELECT * FROM HistorySampleV3 WHERE seriesId = :seriesId AND unknownCode IS NOT NULL ORDER BY elapsedMillis, sequence;

-- Rows strictly between two primary keys of one series: 0 means the two rows are neighbours in reader order.
rowsBetweenV3:
SELECT COUNT(*) FROM HistorySampleV3 WHERE seriesId = :seriesId
AND elapsedMillis >= :fromElapsed AND elapsedMillis <= :toElapsed
AND (elapsedMillis > :fromElapsed OR sequence > :fromSequence)
AND (elapsedMillis < :toElapsed OR sequence < :toSequence);

-- One stored row, by its full primary key.
deleteSampleV3:
DELETE FROM HistorySampleV3 WHERE seriesId = :seriesId AND elapsedMillis = :elapsedMillis AND sequence = :sequence;

-- Gap markers only matter to compaction; the kinds are filtered in Kotlin (HISTORY_GAP_MARKERS), as everywhere else.
compactionMarkersV3:
SELECT elapsedMillis, kind, sourceId FROM HistoryMarkerV2 WHERE rideId = :rideId ORDER BY elapsedMillis, sequence;
