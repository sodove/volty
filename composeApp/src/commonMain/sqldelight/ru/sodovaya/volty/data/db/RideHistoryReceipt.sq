CREATE TABLE HistoryBatchReceiptV2 (
  rideId TEXT NOT NULL,
  receiptId TEXT NOT NULL,
  firstSequence INTEGER NOT NULL,
  nextSequence INTEGER NOT NULL,
  PRIMARY KEY(rideId, receiptId),
  FOREIGN KEY(rideId) REFERENCES HistoryRideV2(id) ON DELETE CASCADE
);

getReceipt:
SELECT * FROM HistoryBatchReceiptV2 WHERE rideId = :rideId AND receiptId = :receiptId;

insertReceipt:
INSERT INTO HistoryBatchReceiptV2(rideId, receiptId, firstSequence, nextSequence)
VALUES (:rideId, :receiptId, :firstSequence, :nextSequence);

deleteReceipts:
DELETE FROM HistoryBatchReceiptV2 WHERE rideId = :rideId;
