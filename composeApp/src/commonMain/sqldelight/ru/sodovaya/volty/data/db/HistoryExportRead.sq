-- Compact (V3) rides. The export streams a ride as the records the encoders read: a known row is one record, a lone
-- unknown is one, and an unknown RUN is two (its first and its end member), so the count below is the number of records
-- emitted, not of stored members (Task 7 of the compact-history-storage plan). A run counts when it STARTS in range, and its end member only when the end is in range too.
exportV3Shape:
SELECT
 (SELECT COALESCE(SUM(CASE WHEN s.unknownCode IS NOT NULL AND s.runCount IS NOT NULL AND s.runEndElapsed <= :toElapsed THEN 2 ELSE 1 END), 0)
  FROM HistorySeriesV3 v JOIN HistorySampleV3 s ON s.seriesId = v.seriesId
  WHERE v.rideNo = :rideNo AND s.elapsedMillis >= :fromElapsed AND s.elapsedMillis <= :toElapsed) AS sampleCount,
 (SELECT COUNT(*) FROM HistoryGpsV2 WHERE rideId = :rideId AND elapsedMillis >= :fromElapsed AND elapsedMillis <= :toElapsed) AS gpsCount,
 (SELECT COUNT(*) FROM HistoryMarkerV2 WHERE rideId = :rideId AND elapsedMillis >= :fromElapsed AND elapsedMillis <= :toElapsed) AS markerCount;

-- The rider's vehicle name, used only to name an exported file.
exportVehicleName:
SELECT name FROM VehicleRow WHERE id = :vehicleId;

exportSources:
SELECT * FROM HistorySourceV2 WHERE rideId = :rideId ORDER BY id LIMIT 2049;

exportRouteFacts:
WITH facts AS (
 SELECT 1 AS routeOrder, sequence, epochMillis, elapsedMillis, clockGeneration,
 latitude, longitude, accuracyMeters, headingDegrees, provider, '' AS markerKind, '' AS sourceId, 0 AS sourcePresent
 FROM HistoryGpsV2 WHERE rideId = :rideId AND elapsedMillis >= :fromElapsed AND elapsedMillis <= :toElapsed
 UNION ALL
 SELECT 0 AS routeOrder, sequence, epochMillis, elapsedMillis, clockGeneration,
 0.0 AS latitude, 0.0 AS longitude, 0.0 AS accuracyMeters, NULL AS headingDegrees, NULL AS provider,
 kind AS markerKind, COALESCE(sourceId, '') AS sourceId, CASE WHEN sourceId IS NULL THEN 0 ELSE 1 END AS sourcePresent
 FROM HistoryMarkerV2 WHERE rideId = :rideId AND elapsedMillis >= :fromElapsed AND elapsedMillis <= :toElapsed
)
SELECT * FROM facts
WHERE :afterElapsed IS NULL OR elapsedMillis > :afterElapsed
OR (elapsedMillis = :afterElapsed AND routeOrder > :afterOrder)
OR (elapsedMillis = :afterElapsed AND routeOrder = :afterOrder AND sequence > :afterSequence)
ORDER BY elapsedMillis, routeOrder, sequence LIMIT :pageSize;

exportLegacyKnownKeys:
SELECT DISTINCT metricKey FROM RidePointRow WHERE rideId = :rideId AND metricKey IN :recognizedKeys
ORDER BY metricKey LIMIT 17;

exportLegacyCount:
WITH fractions AS (
 SELECT *, CASE WHEN substr(timestamp, 20, 1) = '.' THEN
 max(instr(substr(timestamp, 21), 'Z'), instr(substr(timestamp, 21), '+'), instr(substr(timestamp, 21), '-'))
 ELSE 0 END AS zoneStart FROM RidePointRow WHERE rideId = :rideId
), timed AS (
 SELECT *, CAST(strftime('%s', CASE WHEN zoneStart > 0 THEN substr(timestamp, 1, 19) || substr(timestamp, 20 + zoneStart)
 ELSE timestamp END) AS INTEGER) * 1000 + CASE WHEN zoneStart > 0
 THEN CAST(substr(substr(timestamp, 21, zoneStart - 1) || '000', 1, 3) AS INTEGER) ELSE 0 END AS capturedMillis FROM fractions
)
SELECT COUNT(*) FROM timed WHERE capturedMillis >= :fromEpoch AND capturedMillis <= :toEpoch;

exportLegacyRows:
WITH fractions AS (
 SELECT *, CASE WHEN substr(timestamp, 20, 1) = '.' THEN
 max(instr(substr(timestamp, 21), 'Z'), instr(substr(timestamp, 21), '+'), instr(substr(timestamp, 21), '-'))
 ELSE 0 END AS zoneStart FROM RidePointRow WHERE rideId = :rideId
), timed AS (
 SELECT *, CAST(strftime('%s', CASE WHEN zoneStart > 0 THEN substr(timestamp, 1, 19) || substr(timestamp, 20 + zoneStart)
 ELSE timestamp END) AS INTEGER) * 1000 + CASE WHEN zoneStart > 0
 THEN CAST(substr(substr(timestamp, 21, zoneStart - 1) || '000', 1, 3) AS INTEGER) ELSE 0 END AS capturedMillis FROM fractions
)
SELECT rideId, metricKey, timestamp, cellIndex, value, isKnown FROM timed
WHERE capturedMillis >= :fromEpoch AND capturedMillis <= :toEpoch
AND (:afterTimestamp IS NULL OR timestamp > :afterTimestamp
 OR (timestamp = :afterTimestamp AND metricKey > :afterMetric)
 OR (timestamp = :afterTimestamp AND metricKey = :afterMetric AND cellIndex > :afterCell))
ORDER BY timestamp, metricKey, cellIndex LIMIT :pageSize;
